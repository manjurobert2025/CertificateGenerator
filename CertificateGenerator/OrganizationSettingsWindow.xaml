<Window x:Class="CertificateGenerator.OrganizationSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organization Settings"
        Height="620" Width="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Organization Settings"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>
                <TextBlock Text="Configure the details used on your certificates."
                           Margin="0,6,0,0"
                           Foreground="#64748B"/>
            </StackPanel>

            <StackPanel Grid.Row="1">

                <TextBlock Text="Organization Name *"/>
                <TextBox x:Name="OrganizationNameTextBox"
                         Height="34" Margin="0,5,0,14"
                         Padding="8"/>

                <TextBlock Text="Contact Person"/>
                <TextBox x:Name="ContactPersonTextBox"
                         Height="34" Margin="0,5,0,14"
                         Padding="8"/>

                <TextBlock Text="Email"/>
                <TextBox x:Name="EmailTextBox"
                         Height="34" Margin="0,5,0,14"
                         Padding="8"/>

                <TextBlock Text="Phone"/>
                <TextBox x:Name="PhoneTextBox"
                         Height="34" Margin="0,5,0,14"
                         Padding="8"/>

                <TextBlock Text="Website"/>
                <TextBox x:Name="WebsiteTextBox"
                         Height="34" Margin="0,5,0,14"
                         Padding="8"/>

                <TextBlock Text="Address"/>
                <TextBox x:Name="AddressTextBox"
                         Height="70" Margin="0,5,0,14"
                         Padding="8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Organization Logo"/>
                <DockPanel Margin="0,5,0,14">
                    <Button x:Name="BrowseLogoButton"
                            Content="Browse..."
                            Width="100" Height="34"
                            DockPanel.Dock="Right"
                            Click="BrowseLogoButton_Click"/>
                    <TextBox x:Name="LogoPathTextBox"
                             Height="34"
                             Padding="8"
                             IsReadOnly="True"
                             Margin="0,0,10,0"/>
                </DockPanel>
                <TextBlock Text="Authorised Signatory"
            FontSize="16"
            FontWeight="Bold"
            Foreground="#1E293B"
            Margin="0,8,0,12"/>

                <TextBlock Text="Signature Image"/>
                <DockPanel Margin="0,5,0,10">
                    <Button x:Name="BrowseSignatureButton"
             Content="Browse..."
             Width="100"
             Height="34"
             DockPanel.Dock="Right"
             Click="BrowseSignatureButton_Click"/>
                    <TextBox x:Name="SignaturePathTextBox"
              Height="34"
              Padding="8"
              IsReadOnly="True"
              Margin="0,0,10,0"/>
                </DockPanel>

                <Border Background="White"
         BorderBrush="#CBD5E1"
         BorderThickness="1"
         CornerRadius="6"
         Padding="10"
         Height="100"
         Margin="0,0,0,14">
                    <Image x:Name="SignaturePreviewImage"
            Stretch="Uniform"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Authorised Signatory Name"/>
                <TextBox x:Name="SignatoryNameTextBox"
          Height="34"
          Margin="0,5,0,14"
          Padding="8"/>

                <TextBlock Text="Designation"/>
                <TextBox x:Name="SignatoryDesignationTextBox"
          Height="34"
          Margin="0,5,0,14"
          Padding="8"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Content="Cancel"
                        Width="100" Height="38"
                        Margin="0,0,10,0"
                        IsCancel="True"/>
                <Button Content="Save Settings"
                        Width="130" Height="38"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Click="SaveSettingsButton_Click"/>

               

            </StackPanel>
            
        </Grid>
    </ScrollViewer>
</Window>
