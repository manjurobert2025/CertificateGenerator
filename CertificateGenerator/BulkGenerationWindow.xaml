<Window x:Class="CertificateGenerator.BulkGenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Certificate Generation"
        Height="720"
        Width="1150"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Bulk Certificate Generation"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#172554"/>

            <TextBlock Text="Import recipient details, select a template and generate certificates in bulk."
                       Foreground="#64748B"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Import and template controls -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">

            <StackPanel>

                <TextBlock Text="1. Import recipient details"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#172554"
                           Margin="0,0,0,10"/>

                <WrapPanel>
                    <Button Content="Import CSV"
                            Padding="16,9"
                            Margin="0,0,8,8"
                            Background="#2563EB"
                            Foreground="White"
                            Click="ImportCsv_Click"/>

                    <Button Content="Import Excel"
                            Padding="16,9"
                            Margin="0,0,8,8"
                            Background="#15803D"
                            Foreground="White"
                            Click="ImportExcel_Click"/>

                    <Button Content="Download Sample Excel"
                            Padding="16,9"
                            Margin="0,0,8,8"
                            Click="DownloadSampleExcel_Click"/>

                    <Button Content="Load Sample Records"
                            Padding="16,9"
                            Margin="0,0,8,8"
                            Click="LoadSampleCsv_Click"/>

                    <Button Content="Clear"
                            Padding="16,9"
                            Margin="0,0,8,8"
                            Click="Clear_Click"/>
                </WrapPanel>

                <TextBlock x:Name="FileStatusTextBlock"
                           Text="Import a CSV or Excel file to get started."
                           Foreground="#64748B"
                           Margin="0,4,0,12"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Required columns: RecipientName, CourseName. Optional: CertificateId, IssueDate."
                           Foreground="#64748B"
                           FontSize="12"
                           Margin="0,0,0,16"
                           TextWrapping="Wrap"/>

                <Separator Margin="0,0,0,14"/>

                <TextBlock Text="2. Select certificate template"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#172554"
                           Margin="0,0,0,8"/>

                <ComboBox x:Name="TemplatesComboBox"
                          Height="38"
                          MinWidth="300"
                          HorizontalAlignment="Left"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="TemplatesComboBox_SelectionChanged"/>

                <TextBlock x:Name="TemplateStatusTextBlock"
                           Text="Select a saved template."
                           Foreground="#64748B"
                           FontSize="12"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>

        <!-- Preview grid -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12">

            <DataGrid x:Name="BulkCertificatesDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="36">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Certificate ID"
                                        Binding="{Binding CertificateId, UpdateSourceTrigger=PropertyChanged}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Recipient Name"
                                        Binding="{Binding RecipientName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Course Name"
                                        Binding="{Binding CourseName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Issue Date"
                                        Binding="{Binding IssueDate, StringFormat={}{0:dd-MM-yyyy}, UpdateSourceTrigger=PropertyChanged}"
                                        Width="130"/>

                    <DataGridTextColumn Header="Validation"
                                        Binding="{Binding ValidationMessage}"
                                        IsReadOnly="True"
                                        Width="190"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryTextBlock"
                       Text="Records: 0"
                       VerticalAlignment="Center"
                       Foreground="#334155"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>

            <Button Grid.Column="1"
                    Content="Save to Database"
                    Padding="18,12"
                    Margin="0,0,10,0"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="GenerateCertificates_Click"/>

            <!--<Button Grid.Column="2"
                    Content="Export Bulk PDFs"
                    Padding="18,12"
                    Background="#15803D"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="ExportBulkPdfs_Click"/>-->
        </Grid>
    </Grid>
</Window>