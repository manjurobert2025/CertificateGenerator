<Window x:Class="CertificateGenerator.BulkGenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Certificate Generation"
        Height="650"
        Width="1050"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Bulk Certificate Generation"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#172554"/>

            <TextBlock Text="Import recipient details, review records and generate certificates in bulk."
                       Foreground="#64748B"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Import controls -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">

            <StackPanel>
                <WrapPanel VerticalAlignment="Center">

                    <Button Content="Import CSV"
                            Padding="18,10"
                            Margin="0,0,10,8"
                            Background="#2563EB"
                            Foreground="White"
                            Click="ImportCsv_Click"/>

                    <Button Content="Load Sample CSV"
                            Padding="18,10"
                            Margin="0,0,10,8"
                            Click="LoadSampleCsv_Click"/>

                    <Button Content="Clear"
                            Padding="18,10"
                            Margin="0,0,10,8"
                            Click="Clear_Click"/>

                </WrapPanel>

                <TextBlock x:Name="FileStatusTextBlock"
                           Text="Import a CSV file to get started."
                           Foreground="#64748B"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Required columns: RecipientName, CourseName. Optional: CertificateId, IssueDate."
                           Foreground="#64748B"
                           FontSize="12"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Preview grid -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12">

            <DataGrid x:Name="BulkCertificatesDataGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="34">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="Certificate ID"
                                        Binding="{Binding CertificateId, UpdateSourceTrigger=PropertyChanged}"
                                        Width="160"/>

                    <DataGridTextColumn Header="Recipient Name"
                                        Binding="{Binding RecipientName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Course Name"
                                        Binding="{Binding CourseName, UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Issue Date"
                                        Binding="{Binding IssueDate, StringFormat={}{0:dd-MM-yyyy}, UpdateSourceTrigger=PropertyChanged}"
                                        Width="125"/>

                    <DataGridTextColumn Header="Validation"
                                        Binding="{Binding ValidationMessage}"
                                        IsReadOnly="True"
                                        Width="180"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryTextBlock"
                       Text="Records: 0"
                       VerticalAlignment="Center"
                       Foreground="#334155"
                       TextWrapping="Wrap"
                       Margin="0,0,12,0"/>

            <Button Grid.Column="1"
                    Content="Generate Certificates"
                    Padding="20,12"
                    Background="#15803D"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="GenerateCertificates_Click"/>
        </Grid>
    </Grid>
</Window>
