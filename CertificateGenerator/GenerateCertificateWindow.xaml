<Window x:Class="CertificateGenerator.GenerateCertificateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Certificate"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <TextBlock Text="Generate Certificate"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#172554"/>

            <TextBlock Text="Enter the certificate details below."
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,8,0,25"/>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="25">

                <StackPanel>

                    <TextBlock Text="Recipient Name"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="RecipientNameTextBox"
                             Height="38"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="Course / Event Name"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="CourseNameTextBox"
                             Height="38"
                             Margin="0,0,0,18"/>

                    <TextBlock Text="Certificate Date"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <DatePicker x:Name="CertificateDatePicker"
                                Height="35"
                                Margin="0,0,0,25"/>


                    <Button x:Name="GenerateButton"
        Content="Generate Certificate"
        Height="45"
        Background="#2563EB"
        Foreground="White"
        FontSize="15"
        Margin="0,0,0,10"
        Click="GenerateButton_Click"/>

                    <Button x:Name="PreviewButton"
        Content="Preview Certificate"
        Height="42"
        Background="#0F766E"
        Foreground="White"
        FontSize="14"
        Margin="0,0,0,10"
        Click="PreviewCertificateButton_Click"/>

                    <Button x:Name="ExportPdfButton"
        Content="Export Certificate PDF"
        Height="42"
        Background="#475569"
        Foreground="White"
        FontSize="14"
        Click="ExportPdfButton_Click"/>


                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,15,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
