<Window x:Class="CertificateGenerator.CertificateHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Certificate History"
        Height="550"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA">

    <DockPanel Margin="25">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Certificate History"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#172554"/>

            <TextBlock Text="View previously generated certificates."
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,6,0,15"/>

            <DockPanel>
                <TextBox x:Name="SearchTextBox"
                         Height="35"
                         Padding="8"
                         VerticalContentAlignment="Center"
                         ToolTip="Search by recipient, course, or certificate ID"
                         TextChanged="SearchTextBox_TextChanged"/>

                <Button Content="Refresh"
                        Width="100"
                        Margin="10,0,0,0"
                        Click="RefreshButton_Click"/>
            </DockPanel>
        </StackPanel>


        <StackPanel DockPanel.Dock="Bottom"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,15,0,0">

            <Button Content="Preview Selected"
            Width="150"
            Height="40"
            Margin="5"
            Background="#2563EB"
            Foreground="White"
            Click="PreviewSelectedButton_Click"/>

            <Button Content="Print Selected"
        Width="150"
        Height="40"
        Margin="5"
        Background="#15803D"
        Foreground="White"
        Click="PrintSelectedButton_Click"/>

        </StackPanel>

        <DataGrid x:Name="CertificateDataGrid"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          IsSynchronizedWithCurrentItem="False"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal">


            <DataGrid.Columns>
                <DataGridTextColumn Header="Certificate ID"
                                    Binding="{Binding CertificateId}"
                                    Width="180"/>

                <DataGridTextColumn Header="Recipient"
                                    Binding="{Binding RecipientName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Course / Event"
                                    Binding="{Binding CourseName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Issue Date"
                                    Binding="{Binding IssueDate, StringFormat={}{0:dd-MM-yyyy}}"
                                    Width="130"/>
            </DataGrid.Columns>
            
        </DataGrid>

    </DockPanel>
</Window>
