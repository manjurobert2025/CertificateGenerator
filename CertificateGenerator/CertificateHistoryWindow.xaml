<Window x:Class="CertificateGenerator.CertificateHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Certificate History"
        Height="600"
        Width="1050"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header and Search -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">

            <TextBlock Text="Certificate History"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#172554"/>

            <TextBlock Text="View previously generated certificates."
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,6,0,18"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Height="38"
                         Padding="10"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         ToolTip="Search by recipient, course or certificate ID"/>

                <Button Grid.Column="1"
                        Content="Search"
                        Height="38"
                        Margin="0,0,8,0"
                        Background="#2563EB"
                        Foreground="White"
                        Click="SearchButton_Click"/>

                <Button Grid.Column="2"
                        Content="Clear"
                        Height="38"
                        Margin="0,0,8,0"
                        Click="ClearSearchButton_Click"/>

                <Button Grid.Column="3"
                        Content="Refresh"
                        Height="38"
                        Click="RefreshButton_Click"/>
            </Grid>

        </StackPanel>

        <!-- Certificate List -->
        <DataGrid x:Name="CertificateDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsSynchronizedWithCurrentItem="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  RowHeight="30"
                  ColumnHeaderHeight="35"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Certificate ID"
                    Binding="{Binding CertificateId}"
                    Width="2*"/>

                <DataGridTextColumn
                    Header="Recipient"
                    Binding="{Binding RecipientName}"
                    Width="2*"/>

                <DataGridTextColumn
                    Header="Course / Event"
                    Binding="{Binding CourseName}"
                    Width="2*"/>

                <DataGridTextColumn
                    Header="Issue Date"
                    Binding="{Binding IssueDate, StringFormat={}{0:dd-MM-yyyy}}"
                    Width="130"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">

            <Button Content="Preview Selected"
                    Width="145"
                    Height="40"
                    Margin="5"
                    Background="#2563EB"
                    Foreground="White"
                    Click="PreviewSelectedButton_Click"/>

            <Button Content="Print Selected"
                    Width="145"
                    Height="40"
                    Margin="5"
                    Background="#15803D"
                    Foreground="White"
                    Click="PrintSelectedButton_Click"/>

            <Button Content="Delete Selected"
                    Width="145"
                    Height="40"
                    Margin="5"
                    Background="#DC2626"
                    Foreground="White"
                    Click="DeleteSelectedButton_Click"/>

        </StackPanel>

    </Grid>

</Window>
