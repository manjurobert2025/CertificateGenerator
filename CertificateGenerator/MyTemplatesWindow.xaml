<Window x:Class="CertificateGenerator.MyTemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Templates"
        Height="620"
        Width="900"
        MinHeight="500"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="My Templates"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#172554"/>

            <TextBlock Text="View, preview and manage your saved certificate designs."
                       FontSize="14"
                       Foreground="#64748B"
                       Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock x:Name="TemplateCountTextBlock"
                       Text="0 saved templates"
                       Foreground="#64748B"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>

            <Button Content="+ New Template"
                    Padding="14,8"
                    Background="#2563EB"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Click="NewTemplate_Click"
                    DockPanel.Dock="Right"/>
        </DockPanel>

        <!-- Template list -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12">

            <Grid>
                <TextBlock x:Name="EmptyMessageTextBlock"
                           Text="No saved templates yet. Click New Template to create one."
                           Foreground="#64748B"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           Visibility="Collapsed"/>

                <ListBox x:Name="TemplatesListBox"
                         SelectionMode="Single"
                         BorderThickness="0"
                         Background="White"
                         SelectionChanged="TemplatesListBox_SelectionChanged">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,8">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Settings.TemplateName}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="#172554"/>

                                        <TextBlock Text="{Binding Settings.CertificateTitle}"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>

                                        <TextBlock Text="{Binding Settings.OrganizationName}"
                                                   FontSize="12"
                                                   Foreground="#64748B"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="Saved"
                                               Foreground="#15803D"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Actions -->
        <WrapPanel Grid.Row="3"
                   HorizontalAlignment="Right"
                   Margin="0,16,0,0">

            <Button Content="Preview"
                    Padding="16,10"
                    Margin="0,0,8,0"
                    Click="Preview_Click"/>

            <Button Content="Edit"
                    Padding="16,10"
                    Margin="0,0,8,0"
                    Click="Edit_Click"/>

            <Button Content="Delete"
                    Padding="16,10"
                    Margin="0,0,8,0"
                    Click="Delete_Click"/>

            <Button Content="Close"
                    Padding="16,10"
                    Click="Close_Click"/>
        </WrapPanel>
    </Grid>
</Window>
