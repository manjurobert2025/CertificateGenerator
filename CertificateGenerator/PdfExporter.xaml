<Window x:Class="CertificateGenerator.PdfExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Certificate Generator"
        Height="600"
        Width="850"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Bulk Certificate Generator"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#202D40"/>

                <TextBlock Text="Generate individual certificate PDFs from an Excel file and package them into a ZIP."
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Template Selection -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,18">

                <StackPanel>
                    <TextBlock Text="1. Select Certificate Template"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <ComboBox x:Name="TemplatesComboBox"
                              Height="40"
                              DisplayMemberPath="DisplayName"/>
                </StackPanel>
            </Border>

            <!-- Excel File Selection -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,18">

                <StackPanel>
                    <TextBlock Text="2. Select Excel File"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <DockPanel>
                        <Button Content="Browse Excel"
                                Width="120"
                                Height="40"
                                DockPanel.Dock="Right"
                                Margin="10,0,0,0"
                                Click="BrowseExcelButton_Click"/>

                        <TextBox x:Name="ExcelFilePathTextBox"
                                 Height="40"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"
                                 Padding="8"
                                 ToolTip="Selected Excel file path"/>
                    </DockPanel>

                    <TextBlock Text="Required columns: RecipientName, CourseName, IssueDate. CertificateId is optional."
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>

                    <TextBlock Text="Supported format: .xlsx"
                               Foreground="#2563EB"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Export -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="8"
                    Padding="20">

                <StackPanel>
                    <TextBlock Text="3. Generate Certificates"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="ExportStatusTextBlock"
                               Text="Ready to export"
                               Foreground="Gray"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"/>

                    <Button Content="Generate PDFs and Create ZIP"
                            Height="48"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="ExportBulkPdf_Click"/>
                </StackPanel>
            </Border>

        </Grid>
    </ScrollViewer>
</Window>
